      "a": 1,
      "s_hi": "<p>10<span style=\"font-family: Cambria Math;\">.(b) </span><span style=\"font-family: Cambria Math;\">50 </span><span style=\"font-family: Nirmala UI;\">से</span><span style=\"font-family: Cambria Math;\"> 80 </span><span style=\"font-family: Nirmala UI;\">के</span><span style=\"font-family: Cambria Math;\"> </span><span style=\"font-family: Nirmala UI;\">बीच</span><span style=\"font-family: Cambria Math;\"> </span><span style=\"font-family: Nirmala UI;\">अभाज्य</span><span style=\"font-family: Cambria Math;\"> </span><span style=\"font-family: Nirmala UI;\">संख्या </span><span style=\"font-family: Cambria Math;\">= (</span><span style=\"font-family: Cambria Math;\">53 ,</span><span style=\"font-family: Cambria Math;\"> 59 , 61 , 67 , 71 , 73 , 79) = 7</span></p>"
