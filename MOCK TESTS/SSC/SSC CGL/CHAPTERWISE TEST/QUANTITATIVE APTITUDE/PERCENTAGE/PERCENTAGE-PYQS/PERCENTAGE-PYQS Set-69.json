    {
      "q": "<p><span style=\"font-family: Cambria Math;\">10. </span><span style=\"font-family: Cambria Math;\">After spending 20% of his salary on groceries and 30% of the remainder on monthly house rent, a man is left with ₹8,400. What is his monthly salary?</span></p>\n<p><span style=\"font-family: Cambria Math;\">SSC CHSL 08/06/2022 ( Morning )</span></p>",
      "o": [
        "<p>₹42,000</p>",
        "<p>₹28,000</p>",
        "<p>₹16,800</p>",
        "<p>₹15,000</p>"
      ],
      "a": 3,
      "s": "<p>10.(d)</p>\n<p><span style=\"font-family: Cambria Math;\">Let his salary = 100 unit</span></p>\n<p><span style=\"font-family: Cambria Math;\">After spending 20% of his salary, remaining = 100 - 20 = 80 unit</span></p>\n<p><span style=\"font-family: Cambria Math;\">30% of the remainder on house rent = 80 ×<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>70</mn><mn>100</mn></mfrac></math> </span><span style=\"font-family: Cambria Math;\"> = 56 unit</span></p>\n<p><span style=\"font-family: Cambria Math;\">56 unit = 8400</span></p>\n<p><span style=\"font-family: Cambria Math;\">100 unit = 15,000</span></p>"
    }
  ],
